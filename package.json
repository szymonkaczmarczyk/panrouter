{
  "name": "panrouter",
  "version": "0.1.0",
  "private": true,
  "description": "Polski symulator sieci komputerowych z kursem od podstaw do poziomu eksperckiego, quizami, minigrami i egzaminem",
  "type": "module",
  "author": "Szymon Kaczmarczyk",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4400 --strictPort",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4401 --strictPort",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@preact/signals": "^2.11.3",
    "lucide-preact": "^1.59.0",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
